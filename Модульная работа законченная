# ============================================================
# 0. ПОДКЛЮЧЕНИЕ БИБЛИОТЕК И ЧТЕНИЕ ДАННЫХ ИЗ EXCEL
# ============================================================
if (!require("readxl")) install.packages("readxl")
library(readxl)

cat("Выберите Excel-файл со столбцом dt...\n")
file_path <- file.choose()
data <- read_excel(file_path)

dt <- as.numeric(data[[1]])
dt <- dt[!is.na(dt)]
t  <- length(dt)

if (t < 6) stop("Для скользящего среднего с окном до 5 нужно минимум 6 наблюдений.")

# ============================================================
# 1. МЕТОД 1: ПРОГНОЗ = ПРЕДЫДУЩЕЕ ЗНАЧЕНИЕ
# ============================================================
method1 <- function(dt) {
  t  <- length(dt)
  ut <- c(NA, dt[1:(t-1)])
  et <- dt - ut
  etm <- abs(et)
  n <- t - 1
  MAE  <- sum(etm[2:t]) / n
  MAPE <- sum(etm[2:t] / dt[2:t]) / n
  MSE  <- sum(etm[2:t]^2) / n
  RMSE <- sqrt(MSE)
  ut_next <- dt[t]
  list(name = "Метод 1 (ut = dt[i-1])",
       ut = ut, et = et,
       MAE = MAE, MAPE = MAPE, MSE = MSE, RMSE = RMSE,
       ut_next = ut_next)
}

# ============================================================
# 2. МЕТОД 2: ПРОГНОЗ = СРЕДНЕЕ ЗНАЧЕНИЕ РЯДА
# ============================================================
method2 <- function(dt) {
  t  <- length(dt)
  m  <- mean(dt)
  ut <- c(NA, rep(m, t - 1))
  et <- dt - ut
  etm <- abs(et)
  n <- t - 1
  MAE  <- sum(etm[2:t]) / n
  MAPE <- sum(etm[2:t] / dt[2:t]) / n
  MSE  <- sum(etm[2:t]^2) / n
  RMSE <- sqrt(MSE)
  ut_next <- m
  list(name = "Метод 2 (ut = mean(dt))",
       ut = ut, et = et,
       MAE = MAE, MAPE = MAPE, MSE = MSE, RMSE = RMSE,
       ut_next = ut_next)
}

# ============================================================
# 3. МЕТОД 3: СКОЛЬЗЯЩЕЕ СРЕДНЕЕ, n = 2..5
# ============================================================
method3 <- function(dt, n_min = 2, n_max = 5) {
  t <- length(dt)
  if (n_max > t - 1) n_max <- t - 1
  if (n_min > n_max) stop("Некорректный диапазон n для скользящего среднего.")
  
  run_ma <- function(n_ma) {
    mt <- rep(NA, t)
    for (i in n_ma:t) {
      mt[i] <- mean(dt[(i - n_ma + 1):i])
    }
    et  <- dt - mt
    etm <- abs(et)
    idx <- which(!is.na(et))
    k   <- length(idx)
    MAPE <- sum(etm[idx] / dt[idx]) / k
    list(mt = mt, et = et, etm = etm, idx = idx, MAPE = MAPE)
  }
  
  n_grid   <- n_min:n_max
  res_list <- lapply(n_grid, run_ma)
  MAPE_vec <- sapply(res_list, function(x) x$MAPE)
  idx_best <- which.min(MAPE_vec)
  n_best   <- n_grid[idx_best]
  best     <- res_list[[idx_best]]
  
  idx <- best$idx
  k   <- length(idx)
  MAE  <- sum(best$etm[idx]) / k
  MSE  <- sum(best$etm[idx]^2) / k
  RMSE <- sqrt(MSE)
  
  ut_next <- mean(dt[(t - n_best + 1):t])
  
  list(name = paste0("Метод 3 (скользящее среднее, n*=", n_best, ")"),
       ut = best$mt, et = best$et,
       MAE = MAE, MAPE = best$MAPE, MSE = MSE, RMSE = RMSE,
       ut_next = ut_next,
       n_best = n_best, MAPE_grid = MAPE_vec, n_grid = n_grid)
}

# ============================================================
# 4. МЕТОД 4: ЭКСПОНЕНЦИАЛЬНОЕ СГЛАЖИВАНИЕ (подбор n)
# ============================================================
method4 <- function(dt) {
  t <- length(dt)
  ut0 <- dt[1]
  
  calc_MAPE <- function(n) {
    ut <- numeric(t)
    ut[1] <- ut0
    for (i in 2:t) {
      ut[i] <- n * dt[i - 1] + (1 - n) * ut[i - 1]
    }
    et <- dt - ut
    mean(abs(et[2:t] / dt[2:t]))
  }
  
  n_grid <- seq(0.001, 0.999, by = 0.001)
  MAPE_grid <- sapply(n_grid, calc_MAPE)
  n_best <- n_grid[which.min(MAPE_grid)]
  MAPE_best <- min(MAPE_grid)
  
  ut <- numeric(t)
  ut[1] <- ut0
  for (i in 2:t) {
    ut[i] <- n_best * dt[i - 1] + (1 - n_best) * ut[i - 1]
  }
  et  <- dt - ut
  etm <- abs(et)
  k   <- t - 1
  MAE  <- sum(etm[2:t]) / k
  MSE  <- sum(etm[2:t]^2) / k
  RMSE <- sqrt(MSE)
  
  ut_next <- n_best * dt[t] + (1 - n_best) * ut[t]
  
  list(name = paste0("Метод 4 (эксп. сглаж., n*=", round(n_best, 3), ")"),
       ut = ut, et = et,
       MAE = MAE, MAPE = MAPE_best, MSE = MSE, RMSE = RMSE,
       ut_next = ut_next,
       n_best = n_best, MAPE_grid = MAPE_grid, n_grid = n_grid)
}

# ============================================================
# 5. МЕТОД 5: АДАПТИВНАЯ МОДЕЛЬ (подбор n, ut и bt)
# ============================================================
method5 <- function(dt) {
  t <- length(dt)
  
  run_model <- function(n) {
    ut <- numeric(t); bt <- numeric(t); et <- numeric(t)
    ut[1] <- dt[1]
    bt[1] <- dt[2] - dt[1]
    et[1] <- 0
    for (i in 2:t) {
      bt[i] <- bt[i - 1] + et[i - 1] * ((1 - n)^2)
      ut[i] <- ut[i - 1] + bt[i - 1] + (1 - n^2) * et[i - 1]
      et[i] <- dt[i] - ut[i]
    }
    etm <- abs(et)
    MAPE <- sum(abs(et[2:t] / dt[2:t])) / (t - 1)
    list(ut = ut, bt = bt, et = et, etm = etm, MAPE = MAPE)
  }
  
  n_grid <- (1:999) / 1000
  res_list <- lapply(n_grid, run_model)
  MAPE_vec <- sapply(res_list, function(x) x$MAPE)
  idx_best <- which.min(MAPE_vec)
  n_best   <- n_grid[idx_best]
  best     <- res_list[[idx_best]]
  
  k <- t - 1
  MAE  <- sum(best$etm[2:t]) / k
  MSE  <- sum(best$etm[2:t]^2) / k
  RMSE <- sqrt(MSE)
  
  ut_next <- best$ut[t] + best$bt[t] + (1 - n_best^2) * best$et[t]
  
  list(name = paste0("Метод 5 (адаптивная, n*=", round(n_best, 3), ")"),
       ut = best$ut, et = best$et,
       MAE = MAE, MAPE = best$MAPE, MSE = MSE, RMSE = RMSE,
       ut_next = ut_next,
       n_best = n_best,
       bt = best$bt,
       MAPE_grid = MAPE_vec, n_grid = n_grid)
}

# ============================================================
# 6. ЗАПУСК ВСЕХ МЕТОДОВ И ВЫБОР ЛУЧШЕГО ПО MAPE
# ============================================================
res1 <- method1(dt)
res2 <- method2(dt)
res3 <- method3(dt, n_min = 2, n_max = 5)
res4 <- method4(dt)
res5 <- method5(dt)

results  <- list(res1, res2, res3, res4, res5)
MAPE_all <- sapply(results, function(r) r$MAPE)
best_idx <- which.min(MAPE_all)
best     <- results[[best_idx]]

cat("\n========== СРАВНЕНИЕ МЕТОДОВ ==========\n")
summary_df <- data.frame(
