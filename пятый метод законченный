# Чтение данных из файла
# Предполагается, что файл data.csv содержит столбец dt
date <- read.csv(file.choose())
dt = c()
dt = date[[1]]
ut = c(dt[1])
et = c(dt[1]-ut[1])
t = length(dt)
bt = c(dt[2]-dt[1])

MAPE_min = 999
n_min = 0
ut_min = c()
bt_min = c()
et_min = c()
etm_min = c()

MAPE = 0
for (j in 1:999)
{  
  n = j/1000
  for (i in 2:t)
  {
    bt[i] = bt[i-1] + et[i-1] * ((1 - n)^2)
    ut[i] = ut[i-1] + bt[i-1] + (1 - n^2) * et[i-1]
    et[i] = c(dt[i] - ut[i])
    i = i + 1
  }
  etm = c(0)
  for (i in 1:t)
  {
    etm[i] = abs(et[i])
    i = i + 1
  }
  for (i in 2:t)
  {
  MAPE = MAPE + abs(et[i]/dt[i])
  i = i + 1
  }
  MAPE = MAPE * (1/(t-1))
  if(MAPE<MAPE_min)
  {
    MAPE_min = MAPE
    n_min = n
      for (i in 1:t)
      {
        ut_min[i] = ut[i]
        bt_min[i] = bt[i]
        et_min[i] = et[i]
        etm_min[i] = etm[i]
        i = i + 1
      }
  }
}

MAE = 0
MSE = 0
RMSE = 0
for (i in 2:t)
{
  MAE = MAE + etm_min[i]
  MSE = MSE + etm_min[i]^2
  i = i + 1
}
MAE = MAE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)

# --- Построение графиков ---
par(mfrow = c(2, 2))

# 1. Исходный ряд dt
plot(dt, type = "o", col = "blue", pch = 16,
     main = "Исходный ряд dt", xlab = "Индекс", ylab = "dt")
grid()

# 2. Факт dt и оптимальный прогноз ut_min
plot(dt, type = "o", col = "blue", pch = 16,
     ylim = range(c(dt, ut_min), na.rm = TRUE),
     main = paste0("Факт dt и прогноз ut (n* = ", n_min, ")"),
     xlab = "Индекс", ylab = "Значение")
lines(ut_min, type = "o", col = "red", pch = 17)
legend("topleft", legend = c("dt (факт)", "ut_min (прогноз)"),
       col = c("blue", "red"), pch = c(16, 17), lty = 1)

# 3. Ошибки et_min
plot(et_min, type = "o", col = "darkgreen", pch = 16,
     main = "Ошибки et_min = dt - ut_min",
     xlab = "Индекс", ylab = "et_min")
abline(h = 0, lty = 2, col = "gray")
grid()

# 4. Метрики качества
barplot(c(MAE = MAE, MAPE = MAPE_min, MSE = MSE, RMSE = RMSE),
        col = c("steelblue", "orange", "tomato", "seagreen"),
        main = paste0("Метрики (n* = ", n_min, ")"),
        ylab = "Значение")
