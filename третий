date <- read.csv(file.choose())
dt = c()
dt = date[[1]]
n = 3
mt = c(0)
k = 1
t = length(dt)
for (i in 0:t)
{
  while (n > 0)
  {
  mt[i] = mt[i] + dt[i+n]
  n = n - 1
  }
  n = 3
  mt[i] = mt[i]/n
  i = i+1
}
mtm = c(0)
for (i in 1:t)
{
  mtm[i] = abs(mt[i])
}
MAE = 0
MAPE = 0
MSE = 0
RMSE = 0
for (i in 1:t)
{
  MAE = MAE + mtm[i]
  MAPE = MAPE + mtm[i]/dt[i]
  MSE = MSE + mtm[i]^2
}
MAE = MAE * (1/(t-1))
MAPE = MAPE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)

# --- Построение графиков ---
par(mfrow = c(2, 2))

# 1. Исходный ряд dt
plot(dt, type = "o", col = "blue", pch = 16,
     main = "Исходный ряд dt", xlab = "Индекс", ylab = "dt")
grid()

# 2. Факт dt и mt
plot(dt, type = "o", col = "blue", pch = 16,
     ylim = range(c(dt, mt), na.rm = TRUE),
     main = "Факт dt и mt", xlab = "Индекс", ylab = "Значение")
lines(mt, type = "o", col = "red", pch = 17)
legend("topleft", legend = c("dt", "mt"),
       col = c("blue", "red"), pch = c(16, 17), lty = 1)

# 3. Ряд mt
plot(mt, type = "o", col = "darkgreen", pch = 16,
     main = "Ряд mt", xlab = "Индекс", ylab = "mt")
abline(h = 0, lty = 2, col = "gray")
grid()

# 4. Метрики качества
barplot(c(MAE = MAE, MAPE = MAPE, MSE = MSE, RMSE = RMSE),
        col = c("steelblue", "orange", "tomato", "seagreen"),
        main = "Метрики качества", ylab = "Значение")
