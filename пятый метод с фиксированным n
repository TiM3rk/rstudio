dt = c(30, 40, 20, 50, 30, 60)
n = 0.51
ut = c(dt[1])
et = c(dt[1]-ut[1])
bt = c(dt[2]-dt[1])
t = length(dt)
for (i in 2:t)
{
  bt[i] = bt[i-1] + et[i-1] * ((1 - n)^2)
  ut[i] = ut[i-1] + bt[i-1] + (1 - n^2) * et[i-1]
  et[i] = c(dt[i] - ut[i])
  i = i + 1
}
etm = c(0)
for (i in 1:t)
{
  etm[i] = abs(et[i])
}
MAE = 0
MAPE = 0
MSE = 0
RMSE = 0
for (i in 2:t)
{
  MAE = MAE + etm[i]
  MAPE = MAPE + abs(et[i]/dt[i])
  MSE = MSE + etm[i]^2
  i = i + 1
}
MAE = MAE * (1/(t-1))
MAPE = MAPE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)
