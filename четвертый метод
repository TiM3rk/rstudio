date <- read.csv(file.choose())
dt = c()
dt = date[[1]]
n = 3
mt = c(0)
k = 1
t = length(dt)
for (i in 0:t)
{
  while (n > 0)
  {
  mt[i] = mt[i] + dt[i+n]
  n = n - 1
  }
  n = 3
  mt[i] = mt[i]/n
  i = i+1
}
mtm = c(0)
for (i in 1:t)
{
  mtm[i] = abs(mt[i])
}
MAE = 0
MAPE = 0
MSE = 0
RMSE = 0
for (i in 1:t)
{
  MAE = MAE + mtm[i]
  MAPE = MAPE + mtm[i]/dt[i]
  MSE = MSE + mtm[i]^2
}
MAE = MAE * (1/(t-1))
MAPE = MAPE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)
