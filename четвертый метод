dt = c(30, 40, 20, 50, 30, 60)
n = 0.78
ut = c(30)
t = length(dt)
for (i in 2:t)
{
  ut[i] = n*dt[i-1]+(1-n)*ut[i-1]
  i = i + 1
}
et = c(0)
for (i in 1:t)
{
  et[i] = dt[i] - ut[i]
  i = i + 1
}
etm = c(0)
for (i in 1:t)
{
  etm[i] = abs(et[i])
}
MAE = 0
MAPE = c(0)
MSE = 0
RMSE = 0
for (i in 2:t)
{
  MAE = MAE + etm[i]
  MSE = MSE + etm[i]^2
  i = i + 1
}
MAE = MAE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)

for (n_now in 1:999)
{
  ut_now = c(30)
  
  for (i in 2:t)
  {
    ut_now[i] = (n_now/1000)*dt[i-1]+(1-(n_now/1000))*ut_now[i-1]
    i = i + 1
  }
  
  et_now = c(0)
  
  for (i in 1:t)
  {
    et_now[i] = dt[i] - ut_now[i]
    i = i + 1
  }
  
  for (i in 2:t)
  {
    MAPE[n_now] = MAPE[n_now] + abs(et_now[i]/dt[i])
    i = i + 1
  }
  
  MAPE[n_now] = MAPE[n_now] * (1/(t-1))
  n_now = n_now + 1
}
min_Mape = min(MAPE)

# --- Построение графиков ---
par(mfrow = c(2, 2))

# 1. Исходный ряд dt
plot(dt, type = "o", col = "blue", pch = 16,
     main = "Исходный ряд dt", xlab = "Индекс", ylab = "dt")
grid()

# 2. Факт dt и прогноз ut при n = 0.78
plot(dt, type = "o", col = "blue", pch = 16,
     ylim = range(c(dt, ut), na.rm = TRUE),
     main = "Факт dt и прогноз ut (n = 0.78)",
     xlab = "Индекс", ylab = "Значение")
lines(ut, type = "o", col = "red", pch = 17)
legend("topleft", legend = c("dt (факт)", "ut (прогноз)"),
       col = c("blue", "red"), pch = c(16, 17), lty = 1)

# 3. Зависимость MAPE от n
plot(1:999, MAPE, type = "l", col = "darkgreen", lwd = 2,
     main = "Зависимость MAPE от n",
     xlab = "n (в тысячных: n/1000)", ylab = "MAPE")
abline(v = which.min(MAPE), col = "red", lty = 2)
points(which.min(MAPE), min(MAPE), col = "red", pch = 16, cex = 1.5)
legend("topright",
       legend = c(paste0("min MAPE = ", round(min(MAPE), 5)),
                  paste0("n* = ", which.min(MAPE)/1000)),
       col = c("red", "red"), pch = c(16, NA), lty = c(NA, 2))
grid()

# 4. Метрики качества при n = 0.78
barplot(c(MAE = MAE, MSE = MSE, RMSE = RMSE, min_MAPE = min_Mape),
        col = c("steelblue", "tomato", "seagreen", "orange"),
        main = "Метрики качества", ylab = "Значение")
