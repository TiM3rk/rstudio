# Чтение данных из файла
# Предполагается, что файл data.csv содержит столбец dt
date <- read.csv(file.choose())
dt = c()
dt = date[[1]]
# Инициализация векторов
ut <- c(NA)
t <- length(dt)

for (i in 2:t) {
  ut[i] = dt[i-1]
}

et <- c(NA)
etm <- c(NA)
for (i in 2:t) {
  etm[i] = abs(et[i])
}

MAE = 0
MAPE = 0
MSE = 0
RMSE = 0

for (i in 2:t) {
  MAE = MAE + etm[i]
  MAPE = MAPE + etm[i]/dt[i]
  MSE = MSE + etm[i]^2
}

MAE = MAE * (1/(t-1))
MAPE = MAPE * (1/(t-1))
MSE = MSE * (1/(t-1))
RMSE = sqrt(MSE)

# Вывод метрик
cat("MAE  =", MAE, "\n")
cat("MAPE =", MAPE, "\n")
cat("MSE  =", MSE, "\n")
cat("RMSE =", RMSE, "\n")

# Построение графиков
par(mfrow = c(2, 2))

# 1. Исходный ряд dt
plot(dt, type = "o", col = "blue", pch = 16,
     main = "Исходный ряд dt", xlab = "Индекс", ylab = "dt")
grid()

# 2. Прогноз ut vs факт dt
plot(dt, type = "o", col = "blue", pch = 16,
     ylim = range(c(dt, ut), na.rm = TRUE),
     main = "Факт dt и прогноз ut", xlab = "Индекс", ylab = "Значение")
lines(ut, type = "o", col = "red", pch = 17)
legend("topleft", legend = c("dt (факт)", "ut (прогноз)"),
       col = c("blue", "red"), pch = c(16, 17), lty = 1)

# 3. Ошибки et
plot(et, type = "o", col = "darkgreen", pch = 16,
     main = "Ошибки et", xlab = "Индекс", ylab = "et")
abline(h = 0, lty = 2, col = "gray")
grid()

# 4. Метрики качества (барчарт)
barplot(c(MAE = MAE, MAPE = MAPE, MSE = MSE, RMSE = RMSE),
        col = c("steelblue", "orange", "tomato", "seagreen"),
        main = "Метрики качества", ylab = "Значение")
